#!/usr/bin/env bash
#
# isopod — disposable, isolated AI-coding sandboxes for VSCodium (and friends)
#
# Requirements: bash 4+, podman or docker, ssh, ssh-keygen, ssh-keyscan.
# Primary OS: Linux. macOS: works via podman machine / Docker Desktop.
# Windows: run inside WSL2 (see README).
#
# This entry script is the shared constant surface: many globals below are read
# only by the sourced lib/isopod.d/ modules, not here. shellcheck lints each file
# alone, so it would flag those as SC2034 (unused) — disable that check file-wide.
# shellcheck disable=SC2034
set -euo pipefail

ISOPOD_VERSION="2.6.0"

# Resolve the directory this script lives in (following symlinks), so we can
# find bundled helper files under lib/ regardless of how isopod was invoked.
_resolve_script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}
ISOPOD_DIR="$(_resolve_script_dir)"
ISOPOD_LIB="$ISOPOD_DIR/lib"
# Long user-facing text and data tables live as files under share/ rather than
# inline heredocs;
ISOPOD_SHARE="${ISOPOD_SHARE:-$ISOPOD_DIR/share}"
# The sandbox base image, defined as a standard Dockerfile (built by docker and
# podman alike). Override the path with ISOPOD_DOCKERFILE.
ISOPOD_DOCKERFILE="${ISOPOD_DOCKERFILE:-$ISOPOD_SHARE/Dockerfile}"
# The box entrypoint, COPYed into the base image. Hashed into the image tag so
# editing it forces a rebuild, like the Dockerfile. Override alongside it.
ISOPOD_ENTRYPOINT="${ISOPOD_ENTRYPOINT:-$ISOPOD_SHARE/isopod-entrypoint}"
# Shipped, read-only hardening baseline (do not edit — package upgrades replace
# it). Advanced: point at a different baseline with ISOPOD_HARDENING_CONF.
HARDENING_CONF="${ISOPOD_HARDENING_CONF:-$ISOPOD_DIR/security/hardening.conf}"

CONFIG_DIR="${ISOPOD_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/isopod}"
BOXES_DIR="$CONFIG_DIR/boxes"
SSH_INCLUDE_FILE="$CONFIG_DIR/ssh_config"
USER_SSH_CONFIG="$HOME/.ssh/config"
# Optional user override, layered on top of the baseline (mask/unmask/runtime/
# no-runtime). Lives in the user's config dir so it survives package upgrades.
USER_HARDENING_CONF="$CONFIG_DIR/hardening.conf"
# User egress allow-list override (for `egress allow-list`), layered on top of
# the shipped baseline. `isopod egress allow <domain>` appends to this file.
USER_EGRESS_ALLOWLIST="$CONFIG_DIR/egress-allowlist.conf"
# Host-side secret store (`isopod secret`). The keychain backends only use the
# names-only index here; the file backend also keeps 0600 value files.
SECRETS_DIR="$CONFIG_DIR/secrets"
SECRETS_INDEX="$SECRETS_DIR/index"
DEFAULT_BASE_IMAGE="docker.io/library/debian:bookworm-slim"
IMAGE_LAYER_VERSION="3" # bump to force image rebuild when Dockerfile changes
CONTAINER_USER="dev"
CONTAINER_UID="1000" # uid/gid of CONTAINER_USER (share/Dockerfile); owns the secrets tmpfs
# Guest port sshd listens on inside the box (must match ISOPOD_SSHD_PORT in
# share/Dockerfile). Non-privileged on purpose: a virtio-net microVM (krun +
# passt) cannot forward a published host port to a privileged guest port like
# 22, but forwards to a high port fine. Invisible to users — they connect via
# the loopback host port isopod publishes.
BOX_SSHD_PORT="2222"
WORKSPACE="/home/dev/workspace"
# Default guest memory when a Tier 3 microVM runtime is active and the user gave
# no --memory (a microVM boots a fixed-size guest; without this it would be
# starved). Override with ISOPOD_MICROVM_MEMORY or an explicit --memory.
MICROVM_DEFAULT_MEMORY="${ISOPOD_MICROVM_MEMORY:-2g}"
# Extra OCI annotations for a Tier 3 microVM runtime. libkrun/krun reads krun.*
# annotations to tune the guest (e.g. "krun.nested_virt=1" to allow nested virt
# inside the box). Space-separated key=value list, applied by build_run_args as
# --annotation flags when a microVM runtime is active. podman only — annotations
# are a crun/krun feature; docker run has no --annotation.
ISOPOD_MICROVM_ANNOTATIONS="${ISOPOD_MICROVM_ANNOTATIONS:-}"

# Network egress isolation (hardening `egress lan-deny`). Boxes are placed on this
# dedicated fixed-subnet bridge so the host firewall (security/egress-host.nft) can
# target them, and DNS is pinned to a PUBLIC resolver so a box cannot use the host's
# internal/forwarding resolver for reconnaissance. Enforced on the engine at run
# time (an in-box agent cannot undo it). See the README "Network egress isolation".
ISOPOD_EGRESS_NET="${ISOPOD_EGRESS_NET:-isopod0}"
ISOPOD_EGRESS_SUBNET="${ISOPOD_EGRESS_SUBNET:-10.88.7.0/24}"
ISOPOD_EGRESS_GATEWAY="${ISOPOD_EGRESS_GATEWAY:-10.88.7.1}"
ISOPOD_EGRESS_DNS="${ISOPOD_EGRESS_DNS:-1.1.1.1}"
# Fixed host-bridge interface name for the egress network, set when isopod creates
# it (podman --interface-name / docker bridge.name). The nft rulesets scope their
# IPv6 drop to this interface, so box-initiated v6 is blocked host-side even on a
# dual-stack bridge — no reliance on an in-box sysctl. Max 15 chars (IFNAMSIZ).
ISOPOD_EGRESS_IFACE="${ISOPOD_EGRESS_IFACE:-isopod-egr}"
ISOPOD_EGRESS_RULESET="${ISOPOD_EGRESS_RULESET:-$ISOPOD_DIR/security/egress-host.nft}"

# macOS host-level egress (pf). When boxes run on a routable vmnet subnet (Apple
# `container` / vmnet), egress is enforced with pf on the Mac HOST — outside every
# guest VM — in a dedicated pf anchor, instead of nft inside a guest VM. This is
# the escape-resistant boundary; see docs/macos-host-egress.md. The anchor rules
# are rendered from egress-host.pf; the anchor is referenced from pf.conf so it
# survives reboot. ISOPOD_PF_SUBNET overrides the detected box vmnet subnet.
ISOPOD_EGRESS_PF_RULESET="${ISOPOD_EGRESS_PF_RULESET:-$ISOPOD_DIR/security/egress-host.pf}"
ISOPOD_PF_ANCHOR="${ISOPOD_PF_ANCHOR:-com.isopod.egress}"
ISOPOD_PF_ANCHOR_FILE="${ISOPOD_PF_ANCHOR_FILE:-/etc/pf.anchors/com.isopod.egress}"
ISOPOD_PF_CONF="${ISOPOD_PF_CONF:-/etc/pf.conf}"
# LaunchDaemon that re-enables pf and re-loads pf.conf at boot ("isopod egress persist"):
# macOS re-reads pf.conf on boot but does NOT re-enable pf, so egress would otherwise lapse.
ISOPOD_PF_LAUNCHD_PLIST="${ISOPOD_PF_LAUNCHD_PLIST:-/Library/LaunchDaemons/com.isopod.egress.plist}"
# Apple `container`'s default vmnet subnet; override detection with ISOPOD_PF_SUBNET.
ISOPOD_PF_SUBNET_DEFAULT="${ISOPOD_PF_SUBNET_DEFAULT:-192.168.64.0/24}"

# Egress allow-list mode (`egress allow-list`): a host-side filtering proxy
# (tinyproxy) on the bridge gateway is the box's ONLY route out, and only
# allow-listed hostnames pass. Enforced host-side (firewall + proxy), so an
# in-box agent cannot undo it. See docs "Network egress allow-list".
ISOPOD_EGRESS_PROXY_PORT="${ISOPOD_EGRESS_PROXY_PORT:-8118}"
ISOPOD_EGRESS_PROXY_BIN="${ISOPOD_EGRESS_PROXY_BIN:-tinyproxy}"
ISOPOD_EGRESS_PROXY_UNIT="isopod-egress-proxy"
# systemd unit that re-applies the nft ruleset on boot (isopod egress persist).
ISOPOD_EGRESS_NFT_UNIT="isopod-egress-nft"
ISOPOD_EGRESS_ALLOWLIST_RULESET="${ISOPOD_EGRESS_ALLOWLIST_RULESET:-$ISOPOD_DIR/security/egress-allowlist.nft}"
# Shipped allow-list baseline (do not edit); layered with USER_EGRESS_ALLOWLIST.
ISOPOD_EGRESS_ALLOWLIST="${ISOPOD_EGRESS_ALLOWLIST:-$ISOPOD_DIR/security/egress-allowlist.conf}"
# Host state written by `egress apply` (root; apply already needs it): the
# rendered proxy config + filter, and the access log tailed by `egress log`.
ISOPOD_EGRESS_STATE_DIR="${ISOPOD_EGRESS_STATE_DIR:-/etc/isopod/egress}"
ISOPOD_EGRESS_PROXY_LOG_DIR="${ISOPOD_EGRESS_PROXY_LOG_DIR:-/var/log/isopod}"
ISOPOD_EGRESS_PROXY_LOG="${ISOPOD_EGRESS_PROXY_LOG:-$ISOPOD_EGRESS_PROXY_LOG_DIR/egress-proxy.log}"

# ---------------------------------------------------------------------------
# function modules — sourced from lib/isopod.d/ (order: util first, so die()
# exists for everything after it). Each defines functions and their globals
# only; no module runs code at source time.
# ---------------------------------------------------------------------------
for _mod in util engine ssh color hardening egress runargs secret create transfer lifecycle install admin; do
  if [ ! -f "$ISOPOD_LIB/isopod.d/$_mod.sh" ]; then
    # raw printf, not die: die() itself lives in the first module
    printf 'error: missing module: %s (is your isopod install complete?)\n' \
      "$ISOPOD_LIB/isopod.d/$_mod.sh" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  . "$ISOPOD_LIB/isopod.d/$_mod.sh"
done
unset _mod

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  mkdir -p "$BOXES_DIR"
  # Release the lock and unwind a half-finished create no matter how we exit.
  trap on_exit EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    create) cmd_create "$@" ;;
    list | ls) cmd_list "$@" ;;
    info) cmd_info "$@" ;;
    code | open) cmd_code "$@" ;;
    shell | sh) cmd_shell "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    reconfigure | reconfig) cmd_reconfigure "$@" ;;
    config) cmd_config "$@" ;;
    export) cmd_export "$@" ;;
    fetch) cmd_fetch "$@" ;;
    remap) cmd_remap "$@" ;;
    copy-in) cmd_copy_in "$@" ;;
    install) cmd_install "$@" ;;
    rm | remove | delete) cmd_rm "$@" ;;
    gc) cmd_gc "$@" ;;
    egress) cmd_egress "$@" ;;
    secret) cmd_secret "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version | --version | -v) printf 'isopod %s\n' "$ISOPOD_VERSION" ;;
    help | --help | -h) usage ;;
    *) die "unknown command: $cmd (try: isopod help)" ;;
  esac
}

# Only run main when executed directly, not when sourced (e.g. by tests).
# Tests set ISOPOD_SOURCED=1 to load functions without side effects.
if [ -z "${ISOPOD_SOURCED:-}" ]; then
  main "$@"
fi
