# isopod sandbox-account firewall persistence — GENERATED by "isopod account
# setup" into /etc/systemd/system/isopod-account-nft.service. DO NOT EDIT the
# generated copy; it is overwritten on every setup.
#
# Re-applies the sandbox-account egress rules on boot, AFTER firewalld/nftables
# have set up, so the account boundary survives a reboot. It does NOT survive a
# live "firewalld --reload" / "nft flush ruleset" — re-run
# "sudo isopod account setup" after those ("isopod account status" reports
# whether the rules are loaded).
[Unit]
Description=isopod sandbox-account firewall (nftables ruleset)
After=nftables.service firewalld.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$ISOPOD_NFT_BIN -f $ISOPOD_ACCOUNT_STATE_DIR/egress-account.nft
ExecStop=$ISOPOD_NFT_BIN delete table inet isopod_account

[Install]
WantedBy=multi-user.target
