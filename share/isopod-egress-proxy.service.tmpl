# isopod egress filtering proxy — GENERATED by "isopod egress apply" into
# /etc/systemd/system/isopod-egress-proxy.service. DO NOT EDIT the generated
# copy; it is overwritten on every apply.
#
# Keeps the host-side allow-list proxy running (and back up after a reboot) so
# "egress allow-list" boxes always have their enforced route out. ExecReload
# sends SIGHUP, which makes tinyproxy re-read its config and filter file — this
# is how "isopod egress allow <domain>" applies a new domain without a restart.
[Unit]
Description=isopod egress filtering proxy (allow-list)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$ISOPOD_EGRESS_PROXY_BIN -d -c $ISOPOD_EGRESS_STATE_DIR/tinyproxy.conf
ExecReload=/bin/kill -HUP \$MAINPID
Restart=on-failure
RestartSec=2
# The proxy needs no write access to the system beyond its log.
ProtectSystem=strict
ReadWritePaths=$ISOPOD_EGRESS_PROXY_LOG_DIR
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
