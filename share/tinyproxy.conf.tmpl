# isopod egress filtering proxy — GENERATED by "isopod egress apply" into
# $ISOPOD_EGRESS_STATE_DIR/tinyproxy.conf. DO NOT EDIT the generated copy; it is
# overwritten on every apply. Edit the allow-list instead:
#   isopod egress allow <domain>   (or ~/.config/isopod/egress-allowlist.conf)
#
# This is the host-side proxy that enforces the egress allow-list. It listens
# ONLY on the egress bridge gateway, and the host firewall (egress-allowlist.nft)
# makes it the box's only route out. It filters on the requested hostname
# (CONNECT target / Host header) — no TLS interception, so no CA cert is needed.

User $ISOPOD_EGRESS_PROXY_USER
Group $ISOPOD_EGRESS_PROXY_GROUP

# Bind to the egress bridge gateway only — never a public or LAN interface.
Listen $ISOPOD_EGRESS_GATEWAY
Port $ISOPOD_EGRESS_PROXY_PORT

Timeout 600
MaxClients 200

# Log every request (allowed and filtered) so "isopod egress log" / "denied" can
# show what boxes reached for. LogLevel Connect logs each CONNECT/GET host.
LogFile "$ISOPOD_EGRESS_PROXY_LOG"
LogLevel Connect

# Do not advertise the proxy/host in headers to upstreams.
DisableViaHeader Yes

# Only the egress bridge subnet may use the proxy (defense in depth behind nft).
Allow $ISOPOD_EGRESS_SUBNET

# Hostname allow-list. FilterDefaultDeny Yes => only hosts matching a rule in the
# filter file pass; everything else is refused. FilterExtended uses POSIX
# extended regex (isopod generates anchored patterns from the allow-list).
# Matching is against the host, not the full URL (FilterURLs Off, the default).
Filter "$ISOPOD_EGRESS_STATE_DIR/filter"
FilterExtended On
FilterDefaultDeny $FILTER_DEFAULT_DENY

# CONNECT is restricted to the standard TLS ports (tinyproxy default: 443, 563),
# so the tunnel can't be used to reach arbitrary services (e.g. ssh on 22).
