<?xml version="1.0" encoding="UTF-8"?>
<!-- isopod egress firewall persistence — GENERATED by "isopod egress persist" into
     /Library/LaunchDaemons/com.isopod.egress.plist. DO NOT EDIT the generated copy;
     it is overwritten on every persist.

     macOS re-reads /etc/pf.conf at boot (com.apple.pfctl) so the isopod anchor RULES
     re-parse, but it does NOT re-enable pf — the "pfctl -E" refcount does not survive a
     reboot. This LaunchDaemon runs at boot to re-enable pf and load the conf, so a box's
     host-enforced egress isolation actually stays in effect after a reboot. It does NOT
     survive a live "pfctl -d" / "pfctl -F all" — re-run "sudo isopod egress apply" after
     those ("isopod doctor" / "isopod egress status" report whether the rules are loaded). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$ISOPOD_PF_ANCHOR</string>
  <key>RunAtLoad</key>
  <true/>
  <key>ProgramArguments</key>
  <array>
    <string>/sbin/pfctl</string>
    <string>-E</string>
    <string>-f</string>
    <string>$ISOPOD_PF_CONF</string>
  </array>
  <key>StandardErrorPath</key>
  <string>/var/log/isopod-egress-pf.log</string>
</dict>
</plist>
