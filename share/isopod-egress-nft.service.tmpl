# isopod egress firewall persistence — GENERATED by "isopod egress persist" into
# /etc/systemd/system/isopod-egress-nft.service. DO NOT EDIT the generated copy;
# it is overwritten on every persist.
#
# Re-applies the isopod nftables egress ruleset on boot, AFTER firewalld/nftables
# have set up, so a box's host-enforced isolation survives a reboot. It does NOT
# survive a live "firewalld --reload" / "nft flush ruleset" — systemd has no
# reliable hook for those, so re-run "sudo isopod egress apply" after them
# ("isopod doctor" / "isopod egress status" report whether the rules are loaded).
[Unit]
Description=isopod egress firewall (nftables ruleset)
After=nftables.service firewalld.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$ISOPOD_NFT_BIN -f $ISOPOD_EGRESS_STATE_DIR/egress.nft
# Re-write the loaded-marker on boot so a non-root create can tell the rules are
# in effect (the marker lives in /run and is cleared each boot).
ExecStartPost=/bin/sh -c 'printf loaded > $ISOPOD_EGRESS_MARKER 2>/dev/null || true'
ExecStop=$ISOPOD_NFT_BIN delete table inet isopod
ExecStopPost=/bin/sh -c 'rm -f $ISOPOD_EGRESS_MARKER 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
