#!/bin/sh
# isopod box entrypoint — runs as PID 1 in every box.
#
# On boot it gives the box a unique SSH host key, then applies the bootstrap the
# host passes in via the environment (the in-box user's authorized key and sudo
# policy) before starting sshd. Doing this here, rather than via a host-side
# `$ENGINE exec`, lets a box bring itself to a working SSH state under any OCI
# runtime (runc, gVisor, Kata, krun).
#
# ISOPOD_AUTHORIZED_KEY (a public key) and ISOPOD_SUDO (0/1) are non-secret;
# they are consumed and unset before sshd runs so they never reach a login
# session. The in-box user is baked into /etc/isopod-user at image build.

# Drop the runtime's copy of the container's OCI config, first thing.
#
# crun's krun handler writes the whole config.json into the container rootfs as
# /.krun_config.json for the guest to read at boot, mode 0444. On a microVM box
# the guest's / IS that rootfs (exported over virtio-fs), so the file stays
# readable by EVERY process in the box — no sudo and no namespace tricks needed,
# which means --no-sudo boxes are exposed too. It carries host identity that
# nothing in the box has any business seeing:
#
#   root.path      the host path to the container rootfs — host USERNAME and
#                  home layout (e.g. /var/home/<user>/.local/share/containers/…)
#   mount sources  host runtime paths, including the host UID (/run/user/<uid>/…)
#
# By the time this entrypoint runs, the guest has already booted from it, and
# crun rewrites it on every container start — so removing it here is safe and
# self-healing rather than a one-time repair. Absent on non-krun runtimes, where
# this is simply a no-op.
rm -f /.krun_config.json 2>/dev/null || true

iso_u="$(cat /etc/isopod-user)"
iso_h="/home/$iso_u"

# Unique host keys on first boot, so every box has a distinct identity.
if [ ! -f /etc/ssh/.isopod-host-keys ]; then
  rm -f /etc/ssh/ssh_host_*
  ssh-keygen -A >/dev/null
  touch /etc/ssh/.isopod-host-keys
fi

# Authorized key. Append-if-absent, so reboots and reconfigure stay idempotent
# and never overwrite a key the user added inside the box.
if [ -n "${ISOPOD_AUTHORIZED_KEY:-}" ]; then
  install -d -m 700 -o "$iso_u" -g "$iso_u" "$iso_h/.ssh"
  touch "$iso_h/.ssh/authorized_keys"
  grep -qxF "$ISOPOD_AUTHORIZED_KEY" "$iso_h/.ssh/authorized_keys" ||
    printf '%s\n' "$ISOPOD_AUTHORIZED_KEY" >>"$iso_h/.ssh/authorized_keys"
  chown "$iso_u:$iso_u" "$iso_h/.ssh/authorized_keys"
  chmod 600 "$iso_h/.ssh/authorized_keys"
fi

# Administrative root key. The host holds the private half and never puts it in
# the box, so this grants nothing to anything running here — it only lets the
# host come IN as root (`isopod root-shell`). That is what makes a no-sudo box
# administrable without giving the box user a path to root. Append-if-absent,
# matching the user key above, so reboots stay idempotent.
if [ -n "${ISOPOD_ROOT_AUTHORIZED_KEY:-}" ]; then
  install -d -m 700 -o root -g root /root/.ssh
  touch /root/.ssh/authorized_keys
  grep -qxF "$ISOPOD_ROOT_AUTHORIZED_KEY" /root/.ssh/authorized_keys ||
    printf '%s\n' "$ISOPOD_ROOT_AUTHORIZED_KEY" >>/root/.ssh/authorized_keys
  chown root:root /root/.ssh/authorized_keys
  chmod 600 /root/.ssh/authorized_keys
fi

# Sudo policy. Set by create only (1 = passwordless, 0 = none); left untouched
# when unset (e.g. reconfigure) so the box's existing policy is preserved.
if [ "${ISOPOD_SUDO:-}" = "1" ]; then
  printf '%s\n' "$iso_u ALL=(ALL) NOPASSWD:ALL" >"/etc/sudoers.d/$iso_u"
  chmod 440 "/etc/sudoers.d/$iso_u"
elif [ "${ISOPOD_SUDO:-}" = "0" ]; then
  rm -f "/etc/sudoers.d/$iso_u"
fi

# Name resolution note (allow-list egress only). isopod runs an allow-list box
# with `--dns=none`, so this box has no resolver at all: proxied clients hand the
# hostname to the allow-list proxy, which resolves it. podman drops the file
# entirely rather than writing an empty one, so nothing owns /etc/resolv.conf and
# we can put the explanation exactly where someone debugging "Could not resolve
# host" will look first. Comments only — no nameserver line, so glibc falls back
# to 127.0.0.1 and fails in milliseconds instead of hanging on a timeout.
if [ "${ISOPOD_DNS_VIA_PROXY:-}" = "1" ] && [ ! -s /etc/resolv.conf ]; then
  printf '%s\n' \
    '# isopod: this box resolves names through the egress allow-list proxy, not' \
    '# through DNS, so it has no nameserver of its own. "Could not resolve host"' \
    '# means the domain is not allow-listed. Allow it from the HOST with:' \
    '#     isopod egress allow <domain>' \
    >/etc/resolv.conf 2>/dev/null || true
fi

# Secrets tmpfs (mounted by the host only when the box has secrets): hand it
# to the in-box user so inject_secrets can write over SSH. Ownership is set
# here rather than via tmpfs uid=/gid= mount options, which need podman >= 4.9
# and do not exist in docker. Runs on every boot — the tmpfs starts empty.
if [ -d /run/secrets ]; then
  chown "$iso_u:$iso_u" /run/secrets
fi

# Data volume (isopod create --disk). ISOPOD_DISK is "SIZE:MOUNTPOINT". The
# backing image lives in this box's own container layer — there is NO host bind
# mount, so no host directory is exposed; the guest kernel just gets a block
# device over a file the box already owns. Formatted once, on the boot that
# creates it, and loop-mounted on every boot after that.
#
# Nothing here is fatal: sshd must still come up so the box stays reachable and
# the user can read the reason from `$ENGINE logs`.
if [ -n "${ISOPOD_DISK:-}" ]; then
  iso_disk_size="${ISOPOD_DISK%%:*}"
  iso_disk_mount="${ISOPOD_DISK#*:}"
  iso_disk_img="/var/lib/isopod/data.img"
  mkdir -p /var/lib/isopod "$iso_disk_mount"
  if [ ! -f "$iso_disk_img" ]; then
    # Build under a temporary name and rename only on success, so an interrupted
    # or failed mkfs never leaves a file a later boot would mount as formatted.
    if truncate -s "$iso_disk_size" "$iso_disk_img.new" 2>/dev/null &&
      mkfs.ext4 -q -F "$iso_disk_img.new" 2>/dev/null; then
      mv "$iso_disk_img.new" "$iso_disk_img"
    else
      rm -f "$iso_disk_img.new"
      echo "isopod: could not create the $iso_disk_size data volume" >&2
    fi
  fi
  if [ -f "$iso_disk_img" ]; then
    if mount -o loop "$iso_disk_img" "$iso_disk_mount" 2>/dev/null; then
      chown "$iso_u:$iso_u" "$iso_disk_mount"
    else
      echo "isopod: could not mount the data volume at $iso_disk_mount" >&2
      echo "isopod: loop devices need a microVM box (not --container)" >&2
    fi
  fi
fi

# Nested containers (isopod create --nested-containers). Rootless podman inside
# the box needs /dev/fuse (fuse-overlayfs storage) and /dev/net/tun
# (slirp4netns networking), both root-only by default. Hand them to the box user
# specifically rather than making them world-accessible — the mode stays 0600.
if [ "${ISOPOD_NESTED:-}" = "1" ]; then
  for iso_dev in /dev/fuse /dev/net/tun; do
    [ -e "$iso_dev" ] && chown "$iso_u" "$iso_dev" 2>/dev/null
  done
fi

# Kernel hardening (default profile). isopod sets ISOPOD_HARDEN only for microVM
# boxes, which have their own guest kernel — so applying these sysctls affects
# only this box, never the host. Container boxes never receive it. Write straight
# to /proc/sys (portable; no sysctl binary needed) and skip any key that isn't
# writable, so a key the guest kernel doesn't expose — or a read-only entry — is a
# no-op, not a boot failure.
if [ -n "${ISOPOD_HARDEN:-}" ] && [ "$ISOPOD_HARDEN" != off ] &&
  [ -f /etc/isopod/hardening-sysctl.conf ]; then
  while IFS= read -r kv || [ -n "$kv" ]; do
    case "$kv" in '' | '#'*) continue ;; esac
    k="${kv%%=*}"
    v="${kv#*=}"
    p="/proc/sys/$(printf '%s' "$k" | tr . /)"
    [ -w "$p" ] && printf '%s' "$v" >"$p" 2>/dev/null || true
  done </etc/isopod/hardening-sysctl.conf
fi

# Guest egress isolation (microVM boxes only — a container box's entrypoint has no
# CAP_NET_ADMIN, and isopod never sets ISOPOD_GUEST_EGRESS for one).
#
# This block FAILS CLOSED, deliberately breaking the "nothing here is fatal" rule
# the rest of this script follows. Everything above degrades to a warning because
# a half-configured box is better than an unreachable one. Egress is the opposite:
# a box that was asked to be network-isolated and silently came up without it is
# the exact failure that made this necessary. So if the rules cannot be applied,
# sshd does not start — and since sshd is the only way in, no workload runs and
# nothing can reach the network. Read the reason with `$ENGINE logs`.
if [ "${ISOPOD_GUEST_EGRESS:-}" = "1" ]; then
  iso_egress_fail() {
    echo "isopod: FATAL: guest egress isolation was requested but could not be applied:" >&2
    echo "isopod:   $1" >&2
    echo "isopod: refusing to start sshd — a box that cannot enforce its network policy" >&2
    echo "isopod:   must not come up as if it could. Recreate with guest egress off:" >&2
    echo "isopod:   isopod create <name> --guest-egress off   (or set it in hardening.conf)" >&2
    exit 1
  }
  [ -f /etc/isopod/egress-guest.nft ] || iso_egress_fail "/etc/isopod/egress-guest.nft is missing"
  command -v nft >/dev/null 2>&1 || iso_egress_fail "the nft binary is not installed in this box"

  # Default gateway from the kernel's own routing table — no iproute2 needed, and
  # POSIX awk only (mawk is Debian's default and has no strtonum).
  iso_gw=$(awk '
    function hex(s,   i,c,d,n) {
      n = 0
      for (i = 1; i <= length(s); i++) {
        c = toupper(substr(s, i, 1)); d = index("0123456789ABCDEF", c) - 1
        if (d < 0) return -1
        n = n * 16 + d
      }
      return n
    }
    $2 == "00000000" && $8 == "00000000" {
      g = $3
      printf "%d.%d.%d.%d\n", hex(substr(g,7,2)), hex(substr(g,5,2)), hex(substr(g,3,2)), hex(substr(g,1,2))
      exit
    }' /proc/net/route 2>/dev/null)
  case "$iso_gw" in
    [0-9]*.[0-9]*.[0-9]*.[0-9]*) ;;
    *) iso_egress_fail "could not determine the default gateway from /proc/net/route" ;;
  esac

  # The box's own resolvers, exempted on port 53 by the ruleset (see
  # egress-guest.nft). Read straight from resolv.conf so whatever the engine hands
  # the guest keeps working — a VPN resolver on a CGNAT or link-local address
  # included, which is the case the pinned-public-resolver design got wrong.
  #
  # Each address is re-validated here before it reaches the ruleset. resolv.conf is
  # engine-generated, not user input, but this text is about to become firewall
  # rules: anything that is not a bare IPv4 or IPv6 literal is dropped rather than
  # substituted, so a malformed line can never inject a rule.
  iso_ns_rules=$(awk '
    $1 != "nameserver" || $2 == "" { next }
    {
      ip = $2
      if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
        split(ip, o, ".")
        for (i = 1; i <= 4; i++) if (o[i] + 0 > 255) next
        printf "    ip daddr %s udp dport 53 accept\n", ip
        printf "    ip daddr %s tcp dport 53 accept\n", ip
        next
      }
      if (ip ~ /^[0-9a-fA-F:]+$/ && ip ~ /:/) {
        printf "    ip6 daddr %s udp dport 53 accept\n", ip
        printf "    ip6 daddr %s tcp dport 53 accept\n", ip
      }
    }' /etc/resolv.conf 2>/dev/null)

  # No usable resolver at all: fall back to the configured public one, which is
  # better than nothing but will not work on a network that forces local DNS.
  if [ -z "$iso_ns_rules" ] && [ -n "${ISOPOD_GUEST_EGRESS_DNS:-}" ]; then
    printf 'nameserver %s\n' "$ISOPOD_GUEST_EGRESS_DNS" >/etc/resolv.conf 2>/dev/null ||
      iso_egress_fail "could not pin the resolver to $ISOPOD_GUEST_EGRESS_DNS"
    echo "isopod: guest egress: no resolver in /etc/resolv.conf — pinned $ISOPOD_GUEST_EGRESS_DNS." >&2
    echo "isopod:   If your network forces local DNS (a VPN in lockdown mode does), this box" >&2
    echo "isopod:   will not resolve names; recreate it with --guest-egress off." >&2
  fi

  # Anchored to the placeholder alone on its own line. An unanchored match also
  # hits the header comment that names the placeholder, which put the generated
  # rules above `table ... {` — invalid nft, so the box failed closed and never
  # started sshd.
  awk -v gw="$iso_gw" -v rules="$iso_ns_rules" '
    /^@RESOLVERS@$/ { if (rules != "") print rules; next }
    { gsub(/@GATEWAY@/, gw); print }
  ' /etc/isopod/egress-guest.nft >/run/isopod-egress.nft ||
    iso_egress_fail "could not render the ruleset"
  nft -f /run/isopod-egress.nft 2>/run/isopod-egress.err ||
    iso_egress_fail "nft rejected the ruleset: $(cat /run/isopod-egress.err 2>/dev/null)"
  # Confirm it is actually in the kernel rather than trusting nft's exit status.
  nft list table inet isopod_egress >/dev/null 2>&1 ||
    iso_egress_fail "the ruleset did not load into the kernel"
  [ -n "$iso_ns_rules" ] &&
    echo "isopod: guest egress: DNS allowed to$(awk '/ip6? daddr/ && !seen[$3]++ { printf " %s", $3 }' /run/isopod-egress.nft) (port 53 only)" >&2

  echo "isopod: guest egress isolation active (private ranges blocked; gateway $iso_gw allowed)" >&2
fi

unset ISOPOD_AUTHORIZED_KEY ISOPOD_ROOT_AUTHORIZED_KEY ISOPOD_SUDO ISOPOD_HARDEN
unset ISOPOD_DISK ISOPOD_NESTED ISOPOD_DNS_VIA_PROXY ISOPOD_GUEST_EGRESS ISOPOD_GUEST_EGRESS_DNS
mkdir -p /run/sshd
exec /usr/sbin/sshd -D -e
