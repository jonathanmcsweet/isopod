# isopod sandbox account — GENERATED by "isopod account setup" into
# /etc/sudoers.d/isopod-account. DO NOT EDIT the generated copy.
#
# Lets $ISOPOD_ACCOUNT_GRANTEE run the container engine as $ISOPOD_ACCOUNT
# without a password, and nothing else. SETENV is required because rootless
# podman needs XDG_RUNTIME_DIR passed to find the account's runtime directory.
# The grant is scoped to the one binary, as that account, for that user — it is
# not a general sudo grant.
$ISOPOD_ACCOUNT_GRANTEE ALL=($ISOPOD_ACCOUNT) NOPASSWD:SETENV: $ISOPOD_ACCOUNT_ENGINE_BIN
