#compdef isopod
# zsh completion for isopod.
#
# Installed by Homebrew (zsh_completion.install). For a manual install, drop this
# file into a directory on $fpath (e.g. add `fpath+=(/path/to/dir)` before
# `compinit` in ~/.zshrc) and restart zsh.

_isopod_boxes() {
  local boxes_dir="${ISOPOD_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/isopod}/boxes"
  local -a names
  [[ -d $boxes_dir ]] || return 0
  names=("$boxes_dir"/*(/N:t))   # subdirectory basenames, no error if none
  _describe -t boxes 'sandbox' names
}

_isopod() {
  local context state state_descr line
  typeset -A opt_args

  local -a cmds
  cmds=(
    'create:Create and start a new sandbox'
    'list:List sandboxes and their status'
    'info:Show connection details for a sandbox'
    'code:Open the sandbox in VSCodium (or another IDE)'
    'shell:Open a shell inside the sandbox'
    'root-shell:Administrative root shell (host-held key)'
    'upgrade:Rebuild the box onto the current image'
    'start:Start a stopped sandbox'
    'stop:Stop a running sandbox'
    'export:Copy the workspace out of the sandbox'
    'fetch:Pull the box git history into a host repo'
    'remap:Rewrite a box commit identity after fetch'
    'copy-in:Copy more host folders into the sandbox'
    'rm:Delete a sandbox (container + keys)'
    'migrate:Rebuild a box onto or off the sandbox account'
    'egress:Manage the network egress firewall'
    'host-port:Reach a host service from inside a box'
    'account:Sandbox account — opt-in hard egress boundary'
    'secret:Manage secrets injected into boxes'
    'doctor:Check host prerequisites'
    'help:Show help'
    'version:Show version'
  )

  _arguments -C '1: :->cmd' '*:: :->args'

  case $state in
    cmd)
      _describe -t commands 'isopod command' cmds
      ;;
    args)
      case $words[1] in
        create)
          _arguments \
            '*--repo[git repo to clone into the box (repeatable)]:url:' \
            '--branch[branch to clone, applies to every --repo]:branch:' \
            '*--copy[host folder/file to copy in]:path:_files' \
            '--color[window tint preset or #rrggbb]:color:(red orange amber green teal blue purple magenta gray)' \
            '--image[base image]:image:' \
            '--engine[container engine]:engine:(podman docker)' \
            '--memory[memory limit, e.g. 4g]:memory:' \
            '--cpus[cpu limit]:cpus:' \
            '--port[fixed host SSH port]:port:' \
            '*--secret[secret to inject, NAME or NAME\:path]:secret:' \
            '--sudo[grant in-box passwordless sudo (off by default)]' \
            '--no-sudo[no-op; sudo is off by default]' \
            '--no-root-key[no administrative root key either (no root path at all)]' \
            '--guest-egress[in-box network isolation: on|off (default on)]:mode:(on off)' \
            '*--lan-allow[let the box reach one private address]:addr:' \
            '*--host-port[reach a host service from the box: PORT or BOXPORT:HOSTPORT]:spec:' \
            '--account[run the box under the sandbox account (hard egress boundary)]' \
            '--container[run as a plain container instead of the default microVM]' \
            '--dev[add the dev/test toolchain (nested engines, lint/test tools)]' \
            '--disk[box-local data volume, SIZE or SIZE\:MOUNTPOINT (microVM boxes only)]:disk:' \
            '--nested-containers[run containers inside the box (rootless podman + a --disk volume)]'
          ;;
        code)
          _arguments \
            '--app[IDE to launch]:app:(codium vscodium cursor windsurf code)' \
            '--reuse-window[reuse an open IDE window instead of opening a new one]' \
            '1:sandbox:_isopod_boxes'
          ;;
        rm)
          _arguments '(--force -f)'{--force,-f}'[skip confirmation]' '1:sandbox:_isopod_boxes'
          ;;
        remap)
          _arguments \
            '--name[new author/committer name]:name:' \
            '--email[new author/committer email]:email:' \
            '--old-email[identity to rewrite from]:email:' \
            '--old-name[also require this name to match]:name:' \
            '--remap-file[remap many identities from an old -> new file]:file:_files' \
            '(--force -f)'{--force,-f}'[skip confirmation]' \
            '1:sandbox:_isopod_boxes'
          ;;
        fetch)
          _arguments '--path[in-box repo path]:path:' '1:sandbox:_isopod_boxes'
          ;;
        egress)
          _arguments '1:action:(status apply observe persist unpersist allow log denied rules lan-allow lan-denied)'
          ;;
        secret)
          _arguments '1:action:(set ls rm)'
          ;;
        host-port|hostport)
          _arguments '1:action:(add rm ls)' '2:sandbox:_isopod_boxes'
          ;;
        account)
          _arguments '1:action:(setup status teardown rules)'
          ;;
        migrate)
          _arguments '--account[move onto the sandbox account]' '--no-account[move off it]' '--force[skip confirmation]' '1:sandbox:_isopod_boxes'
          ;;
        info|shell|root-shell|upgrade|start|stop|export|copy-in)
          _arguments '1:sandbox:_isopod_boxes'
          ;;
      esac
      ;;
  esac
}

_isopod "$@"
